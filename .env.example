# Configuración de Base de Datos PostgreSQL
POSTGRES_USER=nido
POSTGRES_PASSWORD=nidopass
POSTGRES_DB=nido_db
DATABASE_URL=postgresql://nido:nidopass@db:5432/nido_db?schema=public

# Configuración del Backend NestJS
PORT=4000

# Configuración del Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Inteligencia Artificial (Gemini API - Opcional, cuenta con fallback determinista inteligente)
GEMINI_API_KEY=
